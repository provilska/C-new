    abstract class Pracownik
    {
        public string Imie {  get; private set; }
        public Stanowiska Stanowiska { get; private set; }
        public int StazPracy { get; private set; }
        public int PensjaPodstawowa { get; private set; }

        public abstract double ObliczPensje();
    }
