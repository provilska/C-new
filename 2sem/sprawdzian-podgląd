        private static void InsertionSortWithCount(int[] arr1)
        {
            int count = 0;
            for (int i = 0; i < arr1.Length; i++)
            {
                int key = arr1[i];
                int j = i - 1;
                while (j >= 0 && arr1[j + 1] > key)
                {
                    arr1[j + 1] = arr1[j];
                    j--;
                }
                arr1[j+1] = key;
                count++;

            }
            Console.WriteLine($"Liczba wykonanych zmian: {count}");
        }

        private static void SelectionSort(int[] arr)
        {
            for (int i = 0; i < arr.Length-1; i++)
            {
