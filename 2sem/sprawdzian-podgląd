        private static void SortowaniePrzezWstawianie(int[] tab2)
        {
            for (int i = 0; i < tab2.Length; i++)
            {
                int key = tab2[i];
                int j = i - 1;
                while (j >= 0 && tab2[j + 1] > key)
                {
                    tab2[j + 1] = tab2[j];
                    j--;
                }
                tab2[j + 1] = key;

            }
        }

