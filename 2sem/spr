//sortowanie przez wybór
for(int i = 0; i < produkty.Length - 1; i++)
{
    int minIndex = i;

    for(int j = i + 1; j < produkty.Length; j++)
    {
        if(produkty[j].Nazwa.CompareTo(produkty[minIndex].Nazwa) < 0)
            minIndex = j;
    }

    Produkt temp = produkty[i];
    produkty[i] = produkty[minIndex];
    produkty[minIndex] = temp;
}

//sortowanie przez wstawianie
for(int i = 1; i < produkty.Length; i++)
{
    Produkt key = produkty[i];
    int j = i - 1;

    while(j >= 0 && produkty[j].Nazwa.CompareTo(key.Nazwa) > 0)
    {
        produkty[j + 1] = produkty[j];
        j--;
    }

    produkty[j + 1] = key;
}



internal class Program
{
    static void Main(string[] args)
    {
        int[] tab = { 1, 3, 7, 2, 9, 6, 5, 7 };
        Console.WriteLine("Podaj liczbę");
        int szukane = int.Parse(Console.ReadLine());

        int index = tab[0];

        for (int i = 0; i < tab.Length; i++)
        {
            if (tab[i] == szukane)
            {
                index = i; break;
            }
        }
        Console.WriteLine($"{szukane} ZNAJDUJE SIĘ NA INDEKSIE {index}");

        Console.WriteLine("Podaj liczbę");
        int ilerazy = int.Parse(Console.ReadLine());
        int count = 0;
        for (int i = 0;i < tab.Length; i++)
        {
            if(tab[i] == ilerazy) { count++; }
        }
        Console.WriteLine($"{ilerazy} występuje {count} razy");

        int max = tab[0];
        for(int i = 0; i<tab.Length; i++)
        {
            if (tab[i] > max)
            {
                max = tab[i];
            }
        }
        Console.WriteLine($"Największa liczba to {max}");

        //sortowanie bubble
        for (int i = 0;i<tab.Length-1; i++)
        {
            for (int j = 0; j < tab.Length-1-i; j++)
            {
                if (tab[j]>tab[j+1])
                {
                    int temp = tab[j];
                    tab[j] = tab[j+1];
                    tab[j+1] = temp;
                }
            }
        }
        foreach(var t in tab)
        {
            Console.WriteLine(t.ToString());
        }

        //selection sort
        for(int i =0; i < tab.Length-1; i++)
        {
            int min = i;
            for(int j = i+1; j < tab.Length; j++)
            {
                if(tab[j] < tab[min]){
                    min = j;
                }
        
            }
            int temp = tab[i];
            tab[i] = tab[min];
            tab[min] = temp;
        }
        foreach (var t in tab)
        {
            Console.WriteLine(t.ToString());
        }

        //insert sort
        for (int i = 1;i <tab.Length; i++)
        {
            int key = tab[i];
            int j = i - 1;
            while(j>=0 && tab[j] > key)
            {
                tab[j+1]= tab[j];
                j--;
            }
            tab[j+1] = key;
        }
        
        
        foreach (var t in tab)
        {
            Console.WriteLine(t.ToString());
        }

        int binar = WyszukiwanieBinarne(tab, szukane);
        Console.WriteLine($"{szukane} ZNAJDUJE SIĘ NA INDEKSIE {binar}");
                   //binar

        //losowanie tablicy
        int[] tab2 = new int[10];
        Random rnd = new Random();
        for (int i = 0; i < tab2.Length; i++)
        {
            tab2[i] = rnd.Next(1, 50);
        }
        foreach (var t in tab2)
        {
            Console.WriteLine(t.ToString());
        }
                
    }

    private static int WyszukiwanieBinarne(int[] tab, int szukane)
    {
        int left = 0;
        int right = tab.Length - 1;
        while (left <= right)
        {
            int mid = (left + right) / 2;
            if (tab[mid] == szukane)
            {
                return mid;
            }
            if (szukane > tab[mid])
            {
                left = mid + 1;
            }
            else
            {
                right = mid - 1;
            }
        }
            return -1;
    }
}


