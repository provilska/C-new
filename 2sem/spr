                    tab[j+1] = temp;
                }
            }
        }
        foreach(var t in tab)
        {
            Console.WriteLine(t.ToString());
        }

        //selection sort
        for(int i =0; i < tab.Length-1; i++)
        {
            int min = i;
            for(int j = i+1; j < tab.Length; j++)
            {
                if(tab[j] < tab[min]){
                    min = j;
                }
        
            }
            int temp = tab[i];
            tab[i] = tab[min];
            tab[min] = temp;
        }
        foreach (var t in tab)
        {
            Console.WriteLine(t.ToString());
        }

        int binar = WyszukiwanieBinarne(tab, szukane);
        Console.WriteLine($"{szukane} ZNAJDUJE SIĘ NA INDEKSIE {binar}");
                   //binar
        
    }

    private static int WyszukiwanieBinarne(int[] tab, int szukane)
    {
        int left = 0;
        int right = tab.Length - 1;
        while (left <= right)
        {
            int mid = (left + right) / 2;
            if (tab[mid] == szukane)
            {
                return mid;
            }
            if (szukane > tab[mid])
            {
                left = mid + 1;
            }
            else
            {
                right = mid - 1;
            }
        }
            return -1;
    }
}
