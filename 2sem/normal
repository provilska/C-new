        private static void SortowanieSelectionSort(int[] tab)
        {
            for (int i = 0; i < tab.Length-1; i++)
            {
                int min = i;
                for(int j = i +1; j < tab.Length;j++)
                {
                    if (tab[j] < tab[min])
                    {
                        min = j;
                    }
                }
                int temp = tab[i];
                tab[i] = tab[min];
                tab[min] = temp;
            }
        }
