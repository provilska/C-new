        private static void InsertionSort(int[] tab1)
        {
            for (int i = 1;i < tab1.Length; i++)
            {
                int key = tab1[i];
                int j = i - 1;
                while(j >= 0 && tab1[j]>key)
                {
                    tab1[j+1]=tab1[j];
                    j--;
                }
                tab1[j+1]= key;
            }
        }

        private static void SortowanieSletionSort(Uczen[] uczniowie)
        {
            for (int i = 0; i < uczniowie.Length-1; i++)
            {
                int min = i;
                for(int j = i+1; j < uczniowie.Length; j++)
                {
                    if (uczniowie[j].Srednia.CompareTo(uczniowie[min].Srednia) < 0)
                    {
                        min = j;
                    }
                    var temp = uczniowie[i];
                    uczniowie[i] = uczniowie[min];
                    uczniowie[min] = temp;
                }
            }
        }

        private static void SortowanieInserion(Uczen[] uczniowie)
        {
            for (int i = 1; i < uczniowie.Length; i++)
            {
                Uczen key = uczniowie[i];
                int j = i - 1;
                while (j>= 0 && uczniowie[j].Imie.CompareTo(key.Imie) > 0)
                {
                    uczniowie[j + 1] = uczniowie[j];
                    j--;
                }
                uczniowie[j+1] = key;
            }
        }

        private static void WyszukiwaniePoImieniu(string szukane1, Uczen[] uczniowie)
        {
            int left = 0;
            int right = uczniowie.Length - 1;
            while (left <= right)
            {
                int mid = (left + right) / 2;
                int wynik = uczniowie[mid].Imie.CompareTo(szukane1);
                if (wynik == 0)
                {
                    Console.WriteLine($"{szukane1} znaleziono na indeksie {mid}");
                    return;
                }
                if (wynik < 0)
                {
                    left = mid + 1;
                }
                else
                {
                    right = mid - 1;
                }

            }
        }

        private static void SortowanieInsertionSort(int[] tab)
        {
            for (int i = 1; i < tab.Length; i++)
            {
                int key = tab[i];
                int j = i - 1;
                while (j >= 0 && tab[j]>key)
                {
                    tab[j + 1] = tab[j];
                    j--;
                }
                tab[j+1] = key;
            }
        }

