W programie głównym:
Utwórz tablicę 5 uczniów.
Wykonaj algorytmy:

1.  Wyszukaj ucznia o podanym imieniu (wyszukiwanie liniowe).
2.  Znajdź ucznia z najwyższą średnią.
3.  Znajdź ucznia z najniższą średnią.
4.  Oblicz średnią ocen całej klasy.
5.  Posortuj uczniów rosnąco według średniej (np. sortowanie bąbelkowe).

namespace Uczen
{
    class Uczen
    {
        public string Imie { get; set; }
        public double Srednia { get; set; }

        public Uczen(string imie, double srednia)
        {
            Imie = imie;
            Srednia = srednia;
        }
    }
    internal class Program
    {
        static void Main(string[] args)
        {

            Uczen[] uczniowie = new Uczen[5]
            {
                new Uczen ("Sofia", 2.6),
                new Uczen ("Maksym", 3.0),
                new Uczen ("Michał", 4.8),
                new Uczen ("Lena", 3.2),
                new Uczen ("David", 5.0)
            };
            Console.WriteLine("Podaj szukane imię: \n");
            string szukane = Console.ReadLine();

            WyszukiwaniePoImieniu(szukane, uczniowie);


            Console.WriteLine("Szukam ucznia z najwyższą średnią....");
            Uczen najlepszyUczen = uczniowie[0]; 

            for (int i = 1; i < uczniowie.Length; i++)
            {
                if (uczniowie[i].Srednia > najlepszyUczen.Srednia)
                {
                    najlepszyUczen = uczniowie[i]; 
                }
            }

            Console.WriteLine($"Uczeń z najwyższą średnią to {najlepszyUczen.Imie}, Srednia wynosi {najlepszyUczen.Srednia}");
            

        }

        public static void WyszukiwaniePoImieniu(string szukane, Uczen[] uczniowie)
        {
            for (int i = 0; i < uczniowie.Length; i++)
            {
                if (uczniowie[i].Imie == szukane)
                {
                    Console.WriteLine($"Znaleziono {szukane}\nDane ucznia: Imię: {uczniowie[i].Imie}, Srednia: {uczniowie[i].Srednia}");
                }
            }
        }
    }
}
