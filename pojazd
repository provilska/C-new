    class Pojazd
    {
        private string _marka;
        private string _model;
        private int _rokProdukcji;

        public string Marka { get => _marka; set => _marka = value; }
        public string Model { get => _model; set => _model = value; }
        public int RokProdukcji { get => _rokProdukcji; set => _rokProdukcji = value; }
        public void Info()
        {
            Console.WriteLine($"Podstawowa informacja o pojedzie\nMarka: {Marka}\nModel: {Model}\nRokProdukcji: {RokProdukcji}");
        }
    }
    class Car : Pojazd
    {
        private int _liczbaDrzwi;
        public int LiczbaDrzwi { get => _liczbaDrzwi; set =>  _liczbaDrzwi = value;}
        public void InfoSamochodu()
        {
            base.Info(); 
            Console.WriteLine($"Liczba drzwi: {LiczbaDrzwi}");
        }
    } 
