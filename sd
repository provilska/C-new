namespace Zadanie_z_konstruktorem
{
    class Produkt
    {
        public string Nazwa {  get; set; }
        public int Cena { get; set; }
        public Produkt(string nazwa, int cena)
        {
            nazwa = Nazwa;
            cena = Cena;
        }
    }
    class Napoj : Produkt
    {
        public int Objetnosc { get; set; }
        public Napoj(int objetnosc) : base("mohito", 17)
        {
            objetnosc = Objetnosc;
        }
    }
    internal class Program
    {
        static void Main(string[] args)
        {
            Napoj nap = new Napoj(250);
            Console.WriteLine($"{nap.Nazwa} kosztuje {nap.Cena} i ma {nap.Objetnosc} ml");
        }
    }
}
